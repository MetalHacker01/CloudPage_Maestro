{
  "manifest_version": 3,
  "name": "CloudPage Maestro",
  "version": "5.0.0",
  "description": "Advanced management tool for Salesforce Marketing Cloud CloudPages and Code Resources",
  "author": "Aldorino Rrushi",
  
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },

  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "CloudPage Maestro"
  },

  "permissions": [
    "storage",
    "webRequest"
  ],

  "host_permissions": [
    "https://*.marketingcloudapps.com/*",
    "https://*.exacttarget.com/*",
    "https://*.sfmc-content.com/*"
  ],

  "content_scripts": [
    {
      "matches": [
        "https://*.exacttarget.com/*",
        "https://*.marketingcloudapps.com/*"
      ],
      "js": ["content_full.js"],
      "run_at": "document_end"
    }
  ],

  "background": {
    "service_worker": "background.js"
  },

  "web_accessible_resources": [
    {
      "resources": ["CP_Maestro_Logo.png"],
      "matches": [
        "https://*.exacttarget.com/*",
        "https://*.marketingcloudapps.com/*"
      ]
    }
  ]
}
